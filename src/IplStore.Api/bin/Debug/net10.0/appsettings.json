{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": { "Provider": "SqlServer" },
  "Cart": { "Store": "Redis" },
  "Workers": { "Enabled": true },
  "Orders": { "PendingPaymentTimeoutMinutes": 15 },
  "Database": { "Initialize": false, "Seed": false },
  "Telemetry": { "Enabled": true }
}
